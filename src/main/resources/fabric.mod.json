{
	"schemaVersion": 1,
	"id": "piston-extension",
	"version": "${version}",
	"name": "Piston Extension",
	"description": "Allows pistons to extend 1-3 blocks by right-clicking to cycle extension length.",
	"authors": [
		"justfatlard"
	],
	"license": "MIT",
	"icon": "assets/piston-extension/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.piston_extension.PistonExtension"
		]
	},
	"mixins": [
		"piston-extension.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"fabric-api": "${fabricApiVersion}",
		"pandorical": ">=15.0.0"
	},
	"suggests": {
		"village-quests-justfatlard": "*",
		"block-tip": "*"
	},
	"contact": {
		"homepage": "https://github.com/fatlard1993/piston-extension",
		"sources": "https://github.com/fatlard1993/piston-extension",
		"issues": "https://github.com/fatlard1993/piston-extension/issues"
	}
}
